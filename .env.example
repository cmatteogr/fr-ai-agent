# --- LLM ---
ANTHROPIC_API_KEY=sk-ant-...
# Model used by every agent (override per environment if needed)
FR_AGENT_MODEL=claude-opus-4-8

# --- WhatsApp (Meta Cloud API) ---
# From https://developers.facebook.com > your app > WhatsApp > API Setup
FR_AGENT_WHATSAPP_TOKEN=
FR_AGENT_WHATSAPP_PHONE_NUMBER_ID=
# Any string you choose; must match the webhook config in the Meta dashboard
FR_AGENT_WHATSAPP_VERIFY_TOKEN=change-me

# --- Conversation policy ---
# BCP-47 language the agent speaks with sellers
FR_AGENT_CONVERSATION_LANGUAGE=es
# Hard stop: end the conversation after this many agent turns
FR_AGENT_MAX_TURNS=30